{
  "name": "aerelia",
  "private": true,
  "description": "Aérélia — jeu d'aventure rétro de capture de créatures (outils de développement uniquement : le jeu n'a besoin d'aucune installation)",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "test": "playwright test",
    "format": "prettier --write \"js/**/*.js\" \"css/*.css\" \"tests/**/*.js\" sw.js",
    "check": "prettier --check \"js/**/*.js\" \"css/*.css\" \"tests/**/*.js\" sw.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.10"
  }
}
